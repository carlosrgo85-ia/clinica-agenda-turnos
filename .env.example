# Servidor
PORT=3000

# Proxies delante del servidor web (0 en local). En producción: ver docs/despliegue.md.
# TRUST_PROXY_HOPS=0

# Base de datos (multi-clínica)
DATABASE_URL=postgresql://user:password@localhost:5432/clinica_dental_agent

# WhatsApp — el verify token es global, el token de cada número vive en la DB
WHATSAPP_VERIFY_TOKEN=

# Anthropic (motor de IA compartido por todas las clínicas)
ANTHROPIC_API_KEY=

# URL pública del backend. Se usa para armar el link de "conectar
# calendario" que se le manda a cada clínica, y tiene que coincidir con el
# dominio registrado en el cliente de OAuth.
PUBLIC_BASE_URL=http://localhost:3000

# --- Google Calendar: hay dos modos de acceso y conviven ---
#
# Modo 1 (recomendado): OAuth. Cada clínica conecta su propia cuenta de
# Google desde /oauth/google/start y elige el calendario de una lista.
# Se crea UN cliente de OAuth para toda la plataforma en Google Cloud
# Console (tipo "Aplicación web"). La redirect URI tiene que estar
# registrada ahí idéntica, carácter por carácter.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Microsoft 365 / Outlook (opcional). Ver docs/onboarding-clinica.md.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
# "common" acepta cuentas de cualquier organización y personales.
# MICROSOFT_OAUTH_TENANT=common

# Clave con la que se cifran las credenciales guardadas en la base: el
# token de WhatsApp de cada clínica y los refresh tokens de OAuth de
# Google. También firma el state del flujo de OAuth.
# OBLIGATORIA para operar: sin ella no se puede descifrar el token de
# WhatsApp y no sale ningún mensaje (el nombre quedó de cuando solo
# protegía los calendarios).
# Generar con: openssl rand -hex 32
# Si se cambia: cada clínica tiene que reconectar su calendario y hay que
# volver a cargar su token de WhatsApp.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Modo 2 (el viejo): cuenta de servicio compartida. La clínica tiene que
# compartirle cada calendario a mano como editora y pasar el calendar ID.
# Opcional si todos los calendarios se conectan por OAuth.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Envío de emails (reporte diario). Una sola cuenta SMTP para toda la
# plataforma; el destinatario de cada reporte es el email de cada Clinic.
# SMTP_USER se usa también como remitente (`from`): tiene que tener forma de
# email (ej. "dev@localhost" en desarrollo con Mailhog) — un valor como
# "dev" a secas hace que el servidor SMTP rechace el envío.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Autenticación del dashboard (usuarios, roles, permisos) ---
#
# Con qué se firman los JWT de sesión (cookie httpOnly). Generar con:
#   openssl rand -hex 32
# Si se cambia, todas las sesiones activas quedan inválidas.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen público del frontend (la SPA en /app). Se usa para armar los
# links de los emails de invitación y de recuperación de contraseña, y el
# link de los avisos de configuración incompleta.
FRONTEND_URL=http://localhost:3000

# Nota: dentistas, consultorios, plan (Base/Plus) y feature flags viven en
# la base de datos (tabla Clinic/Dentist/Room), no acá. Ver scripts/add-clinic.ts.

# Zona horaria con la que se decide qué día es "hoy" en los avisos de la
# plataforma (vencimiento de secretos). Una zona IANA; default UTC.
# PLATFORM_TIMEZONE=UTC
